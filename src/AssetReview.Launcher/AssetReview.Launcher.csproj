<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <UseAppHost>false</UseAppHost>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>asset-review</ToolCommandName>
    <PackageId>SharpNinja.AssetReview.Tool</PackageId>
    <Authors>SharpNinja</Authors>
    <Description>Reusable local asset and wireframe approval review tool for PNG and SVG folders.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeAssetReviewPayloads</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../AssetReview.Tool/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Target Name="IncludeAssetReviewPayloads">
    <Error Condition="'$(AssetReviewPayloadRoot)' == '' Or !Exists('$(AssetReviewPayloadRoot)')"
           Text="Package AssetReview through the Nuke PackAssetReviewTool target to publish the application payloads first." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(AssetReviewPayloadRoot)/**/*" PackagePath="tools/$(TargetFramework)/any/apps/" />
    </ItemGroup>
  </Target>
</Project>
